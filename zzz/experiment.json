            "NOTION_TOKEN": "ntn_I62544521722KdBamTyxQpqTDQOW8CT9XW1r2IimEmN6M4"
          }
        },    
    "generic-agent": {
      "command": "python",
      "args": [
        "/home/nizar/HomeWspce/My-bedrock-agents-wrappers/bedrock_multi_project_wrapper.py"
      ],
      "env": {
        "AGENT_ID": "4EBXLZQW3Q",
        "AWS_REGION": "ca-central-1"
      }
    },
    "awslabs.bedrock-kb-retrieval-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.bedrock-kb-retrieval-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "csna-operations-sso",
        "AWS_REGION": "ca-central-1",
        "FASTMCP_LOG_LEVEL": "ERROR",
        "KB_INCLUSION_TAG_KEY": "optional-tag-key-to-filter-kbs",
