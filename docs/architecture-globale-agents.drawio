<mxfile host="app.diagrams.net">
  <diagram id="agent-architecture" name="Architecture Globale des Agents">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Architecture Globale des Agents — kiro-configs&lt;/b&gt;&lt;br&gt;Nizar Ajroud | 2026-08-26 | Post-rollback (agents domaine + toggle via qq --mcp)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="row1-label" value="&lt;b&gt;AGENTS DOMAINE&lt;/b&gt; (permanents, mémoire, MCPs directs — toggle via qq --mcp)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="it-supervisor" value="&lt;b&gt;IT-Supervisor&lt;/b&gt;&lt;br&gt;&lt;i&gt;Orchestrateur&lt;/i&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;13 MCPs actifs&lt;br&gt;memory-supervisor&lt;br&gt;agentcore-memory&lt;br&gt;notion-workspace&lt;br&gt;github, firecrawl&lt;br&gt;bookmarks, aws-knowledge&lt;br&gt;mcp-image-recognition&lt;br&gt;sequential-thinking&lt;br&gt;time, fetch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="180" height="240" as="geometry" />
        </mxCell>
        <mxCell id="compass" value="&lt;b&gt;Compass&lt;/b&gt;&lt;br&gt;&lt;i&gt;Vie personnelle&lt;/i&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;14 actifs + 6 désactivés&lt;br&gt;gmail, telegram&lt;br&gt;airtable, ticktick&lt;br&gt;notebooklm, markitdown&lt;br&gt;pdf-reader, excel&lt;br&gt;google-maps, secondhand&lt;br&gt;+ globaux hérités&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=center;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="240" y="120" width="180" height="240" as="geometry" />
        </mxCell>
        <mxCell id="exp2" value="&lt;b&gt;Exp2&lt;/b&gt;&lt;br&gt;&lt;i&gt;Travail technique&lt;/i&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;24 actifs + 18 désactivés&lt;br&gt;gitlab, context7, terraform&lt;br&gt;aws-pricing, eks, aws-api&lt;br&gt;mcp-mermaid, excalidraw&lt;br&gt;rtl-visual, d2-mcp&lt;br&gt;linkedin, whatsapp, ssh&lt;br&gt;+ globaux hérités&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=center;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="180" height="240" as="geometry" />
        </mxCell>
        <mxCell id="forge" value="&lt;b&gt;Forge&lt;/b&gt;&lt;br&gt;&lt;i&gt;Outillage&lt;/i&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;13 MCPs actifs&lt;br&gt;memory-forge&lt;br&gt;agentcore-memory&lt;br&gt;notion-workspace&lt;br&gt;github, firecrawl&lt;br&gt;bookmarks, aws-knowledge&lt;br&gt;mcp-image-recognition&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=center;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="180" height="220" as="geometry" />
        </mxCell>
        <mxCell id="light" value="&lt;b&gt;Light&lt;/b&gt;&lt;br&gt;&lt;i&gt;Rapide&lt;/i&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;13 MCPs actifs&lt;br&gt;(même set que Forge)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=center;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="840" y="120" width="150" height="140" as="geometry" />
        </mxCell>
        <mxCell id="row2-label" value="&lt;b&gt;AGENTS SPÉCIAUX&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="media1" value="&lt;b&gt;Media1&lt;/b&gt;&lt;br&gt;&lt;i&gt;Audio/TTS&lt;/i&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1 MCP actif&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="140" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sandbox" value="&lt;b&gt;Sandbox&lt;/b&gt;&lt;br&gt;&lt;i&gt;Test isolé&lt;/i&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;agentcore-memory&lt;br&gt;+ 1 MCP temporaire&lt;br&gt;(préparé par Forge)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;spacingTop=5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="440" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;• Agents domaine : MCPs directs (tool call = ms)&lt;br&gt;• MCPs désactivés : activables via &lt;code&gt;qq --mcp&lt;/code&gt;&lt;br&gt;• Agents expertise (connect1-3, data1, aws1, diagram1, dev1-2, customer1, parking1) : archivés dans zzz/&lt;br&gt;• Inter-agent : use_subagent si outil absent localement" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=6;fillColor=#eeeeee;strokeColor=#cccccc;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="550" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
