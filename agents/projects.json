{
  "name": "projects",
  "description": "Project management and content creation — GitHub, Notion, NotebookLM, MURAL, ideas.",
  "prompt": "file://./projects.md",
  "mcpServers": {
    "github": {
      "command": "python3",
      "args": [
        "/home/nizar/.kiro/wrappers/github_wrapper.py"
      ],
      "env": {
        "GITHUB_READ_ONLY": "0",
        "GITHUB_TOOLSETS": "all"
      }
    },
    "notion-workspace": {
      "command": "python3",
      "args": [
        "/home/nizar/HomeWspce/kiro-configs/wrappers/notion_wrapper.py"
      ],
      "env": {
        "GITHUB_REPO": "nizarajroud/notion-images"
      }
    },
    "notebooklm": {
      "command": "notebooklm-mcp",
      "args": []
    },
    "mural": {
      "command": "python3",
      "args": [
        "/home/nizar/HomeWspce/kiro-configs/wrappers/mural_wrapper.py"
      ]
    },
    "idea": {
      "command": "python3",
      "args": [
        "/home/nizar/.kiro/wrappers/idea_prompt_wrapper.py"
      ]
    }
  },
  "tools": [
    "*"
  ],
  "allowedTools": [
    "@builtin",
    "@github",
    "@notion-workspace",
    "@notebooklm",
    "@mural",
    "@idea"
  ],
  "resources": [
    "file://.kiro/steering/**/*.md"
  ],
  "hooks": {
    "preToolUse": [
      {
        "matcher": "fs_write",
        "command": "/home/nizar/.kiro/hooks/check-secrets.sh",
        "description": "Block writes containing secrets"
      },
      {
        "matcher": "execute_bash",
        "command": "/home/nizar/.kiro/hooks/guard-destructive-commands.sh",
        "description": "Block dangerous shell commands"
      }
    ],
    "stop": [
      {
        "command": "/home/nizar/.kiro/hooks/flywheel-log.sh",
        "description": "Log turn summary for flywheel analysis"
      }
    ]
  },
  "toolsSettings": {},
  "useLegacyMcpJson": false,
  "model": "claude-sonnet-4.6"
}
