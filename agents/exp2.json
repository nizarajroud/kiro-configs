{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "exp2",
  "description": "Multi-tool agent with access to Bedrock knowledge bases, AWS documentation, and diagram generation",
  "prompt": "file://../prompts/exp2-prompt.md",
  "mcpServers": {
    "bedrock-project-agent": {
      "description": "Queries an Amazon Bedrock agent connected to project knowledge bases. Use this for project-specific questions: RFP details, client requirements, estimated hours, timelines, budgets, and any domain-specific or organizational data ingested into the knowledge base.",
      "command": "python",
      "args": [
        "/home/nizar/.kiro/wrappers/bedrock_multi_project_wrapper.py"
      ],
      "env": {
        "AGENT_ID": "4EBXLZQW3Q",
        "AGENT_ALIAS_ID": "TSTALIASID",
        "AWS_REGION": "ca-central-1"
      },
      "disabled": true,
      "priority": "standard"
    },
    "claude-cli": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "http://192.168.2.56:3108/mcp",
        "--allow-http"
      ],
      "disabled": true,
      "_original": {
        "command": "python",
        "args": [
          "/home/nizar/.kiro/wrappers/claude_cli_wrapper.py"
        ]
      }
    },
    "remote.awslabs.bedrock-kb-retrieval-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "http://192.168.2.56:3213/mcp",
        "--allow-http"
      ],
      "env": {
        "AWS_PROFILE": "csna-operations-sso-828",
        "AWS_REGION": "ca-central-1",
        "FASTMCP_LOG_LEVEL": "ERROR",
        "KB_INCLUSION_TAG_KEY": "optional-tag-key-to-filter-kbs",
        "BEDROCK_KB_RERANKING_ENABLED": "false"
      },
      "disabled": true,
      "autoApprove": [],
      "_original": {
        "command": "uvx",
        "args": [
          "awslabs.bedrock-kb-retrieval-mcp-server@latest"
        ]
      }
    },
    "markdown2pdf": {
      "description": "Converts Markdown content to PDF files. Supports headers, bold/italic, lists, tables, code blocks with syntax highlighting, images (local and remote), task lists, blockquotes, links, and Mermaid diagrams. Does not support LaTeX math. PDFs are saved to the configured M2P_OUTPUT_DIR. Use the create_pdf_from_markdown tool with a markdown string and an output filename.",
      "command": "node",
      "args": [
        "/home/nizar/.npm-global/lib/node_modules/markdown2pdf-mcp/build/index.js"
      ],
      "env": {
        "M2P_OUTPUT_DIR": "/home/nizar/workspace/assets/markdown2pdf-output"
      },
      "disabled": true
    },
    "memory-exp2": {
      "command": "mcp-server-memory",
      "args": [],
      "env": {
        "MEMORY_FILE_PATH": "/home/nizar/HomeWspce/kiro-configs/memories/memory-exp2.jsonl"
      },
      "disabled": false,
      "priority": "critical"
    }
  },
  "tools": [
    "*"
  ],
  "toolAliases": {
    "@remote.bridge.aws-mcp/aws___read_documentation": "aws_mcp_read_docs",
    "@remote.bridge.aws-mcp/aws___get_regional_availability": "aws_mcp_regional_availability",
    "@remote.bridge.aws-mcp/aws___search_documentation": "aws_mcp_search_docs",
    "@remote.bridge.aws-mcp/aws___list_regions": "aws_mcp_regions",
    "@remote.bridge.aws-mcp/aws___recommend": "aws_mcp_recommend",
    "@remote.bridge.aws-mcp/aws___retrieve_skill": "aws_mcp_retrieve_skill",
    "@git-mcp/search_code": "gitmcp_search_code"
  },
  "allowedTools": [
    "*"
  ],
  "resources": [
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/shared/*.md",
    "file://AmazonQ.md",
    "file://README.md",
    "file://.amazonq/rules/**/*.md",
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/work/steering/*.md",
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/work/config/domains.yaml",
    "skill:///home/nizar/HomeWspce/kiro-configs/knowledges/work/domains/**/*.md",
    "skill:///home/nizar/HomeWspce/kiro-configs/skills/**/*.md",
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/misc/steering/*.md",
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/misc/config/domains.yaml",
    "skill:///home/nizar/HomeWspce/kiro-configs/knowledges/misc/domains/**/*.md"
  ],
  "hooks": {
    "preToolUse": [
      {
        "matcher": "execute_bash",
        "command": "if echo \"$COMMAND\" | grep -qE '^git push'; then echo 'Error: git push is blocked' >&2; exit 1; fi"
      }
    ],
    "stop": [
      {
        "command": "/home/nizar/.kiro/hooks/store-conversation.sh"
      }
    ]
  },
  "toolsSettings": {},
  "useLegacyMcpJson": true,
  "welcomeMessage": "\u26a1 Exp2 ready. Your work & technical agent \u2014 code, cloud, architecture, and beyond."
}
