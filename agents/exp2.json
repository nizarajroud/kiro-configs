{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "exp2",
  "description": "Multi-tool agent with access to Bedrock knowledge bases, AWS documentation, and diagram generation",
  "prompt": "file://../prompts/exp2-prompt.md",
  "mcpServers": {
    "memory-exp2": {
      "command": "mcp-server-memory",
      "args": [],
      "env": {
        "MEMORY_FILE_PATH": "/home/nizar/HomeWspce/kiro-configs/memories/memory-exp2.jsonl"
      },
      "disabled": false,
      "priority": "critical"
    },
    "mcp-everything-search": {
      "description": "Fast file search across all disks (Windows via /mnt/c/ + Linux). Uses plocate. Query by filename, extension, pattern.",
      "command": "uvx",
      "args": [
        "mcp-server-everything-search"
      ],
      "disabled": false
    },
    "tts-live": {
      "description": "Text-to-Speech LIVE \u2014 reads text aloud immediately via Google Gemini TTS. Use when user asks to read, speak, or listen to content.",
      "command": "/home/nizar/go/bin/mcp-tts",
      "args": [],
      "env": {
        "GOOGLE_AI_API_KEY": "${GOOGLE_AI_API_KEY}",
        "MCP_TTS_SUPPRESS_SPEAKING_OUTPUT": "true"
      },
      "disabled": false
    },
    "d2-mcp": {
      "description": "D2 diagram language \u2014 compile, validate, and render diagrams (SVG, PNG, ASCII). Sketch mode, themes. Always saves output files.",
      "command": "/home/nizar/go/bin/d2-mcp",
      "args": [
        "--image-type",
        "svg",
        "--write-files"
      ],
      "disabled": false
    },
    "airtable": {
      "description": "Airtable database MCP server. Use this to create, read, update, and delete records in Airtable bases. Provides a visual web interface (kanban, grid, calendar) for data that the agent pushes. Bidirectional: agent writes data, user interacts visually, agent reads back changes.",
      "command": "npx",
      "args": [
        "-y",
        "airtable-mcp-server"
      ],
      "env": {
        "AIRTABLE_API_KEY": "${AIRTABLE_API_KEY}"
      },
      "disabled": true
    },
    "secondhand-mcp": {
      "description": "Search secondhand marketplaces (Facebook Marketplace, eBay, Depop, Poshmark) for used items. Use when user asks to find articles, meubles, electronics on Facebook Marketplace or other used-goods platforms.",
      "command": "python3",
      "args": [
        "/home/nizar/HomeWspce/kiro-configs/wrappers/secondhand_wrapper.py"
      ],
      "env": {
        "MARKETPLACES": "facebook"
      },
      "disabled": false
    }
  },
  "tools": [
    "*"
  ],
  "toolAliases": {
    "@remote.bridge.aws-mcp/aws___read_documentation": "aws_mcp_read_docs",
    "@remote.bridge.aws-mcp/aws___get_regional_availability": "aws_mcp_regional_availability",
    "@remote.bridge.aws-mcp/aws___search_documentation": "aws_mcp_search_docs",
    "@remote.bridge.aws-mcp/aws___list_regions": "aws_mcp_regions",
    "@remote.bridge.aws-mcp/aws___recommend": "aws_mcp_recommend",
    "@remote.bridge.aws-mcp/aws___retrieve_skill": "aws_mcp_retrieve_skill",
    "@git-mcp/search_code": "gitmcp_search_code"
  },
  "allowedTools": [
    "*",
    "@mcp-everything-search",
    "@tts-live",
    "@tts-record"
  ],
  "resources": [
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/shared/*.md",
    "file://AmazonQ.md",
    "file://README.md",
    "file://.amazonq/rules/**/*.md",
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/work/steering/*.md",
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/work/config/domains.yaml",
    "skill:///home/nizar/HomeWspce/kiro-configs/knowledges/work/domains/**/*.md",
    "skill:///home/nizar/HomeWspce/kiro-configs/skills/**/*.md",
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/misc/steering/*.md",
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/misc/config/domains.yaml",
    "skill:///home/nizar/HomeWspce/kiro-configs/knowledges/misc/domains/**/*.md",
    "skill:///home/nizar/HomeWspce/kiro-configs/skills/*/SKILL.md",
    "skill:///home/nizar/HomeWspce/kiro-configs/skills/*/*/SKILL.md",
    "skill:///home/nizar/HomeWspce/kiro-configs/skills/*/*/*/SKILL.md"
  ],
  "hooks": {
    "preToolUse": [
      {
        "matcher": "execute_bash",
        "command": "if echo \"$COMMAND\" | grep -qE '^git push'; then echo 'Error: git push is blocked' >&2; exit 1; fi"
      }
    ],
    "stop": [
      {
        "command": "/home/nizar/.kiro/hooks/store-conversation.sh"
      }
    ]
  },
  "toolsSettings": {},
  "useLegacyMcpJson": true,
  "welcomeMessage": "\u26a1 Exp2 ready. Your work & technical agent \u2014 code, cloud, architecture, and beyond."
}