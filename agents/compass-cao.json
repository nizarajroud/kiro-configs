{
  "name": "compass-cao",
  "description": "Personal life orchestrator \u2014 handles personal affairs, health follow-ups, family tasks, reminders. Receives delegated tasks from other agents via CAO.",
  "tools": [
    "*"
  ],
  "allowedTools": [
    "@cao-mcp-server",
    "fs_read",
    "grep",
    "glob",
    "@notebooklm",
    "@notion-workspace",
    "@gmail",
    "@ticktick",
    "@excel",
    "@telegram",
    "@bookmarks",
    "@memory",
    "@airtable",
    "@pdf-reader"
  ],
  "useLegacyMcpJson": false,
  "resources": [
    "file:///home/nizar/.aws/cli-agent-orchestrator/agent-context/compass.md",
    "skill:///home/nizar/.aws/cli-agent-orchestrator/skills/**/SKILL.md",
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/personal/steering/*.md",
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/personal/config/domains.yaml"
  ],
  "mcpServers": {
    "cao-mcp-server": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/nizarajroud/cli-agent-orchestrator.git@main",
        "cao-mcp-server"
      ]
    }
  }
}
