{
  "name": "aws-cloud",
  "description": "AWS specialist — documentation, CLI, infrastructure, architecture diagrams.",
  "prompt": "file://./aws-cloud.md",
  "mcpServers": {
    "remote.aws-knowledge": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://knowledge-mcp.global.api.aws"
      ]
    },
    "remote.bridge.aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ]
    },
    "local.aws-diagram-generator": {
      "command": "/home/nizar/HomeWspce/mcp/src/aws-diagram-mcp-server/.venv/bin/python",
      "args": [
        "-m",
        "awslabs.aws_diagram_mcp_server.server"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "local.diagram-prompt-templates": {
      "command": "python3",
      "args": [
        "-u",
        "/home/nizar/HomeWspce/diagram-prompts-mcp/server.py"
      ]
    }
  },
  "tools": [
    "*"
  ],
  "allowedTools": [
    "@builtin",
    "@remote.aws-knowledge",
    "@remote.bridge.aws-mcp",
    "@local.aws-diagram-generator",
    "@local.diagram-prompt-templates"
  ],
  "resources": [
    "file://.kiro/steering/**/*.md"
  ],
  "hooks": {
    "preToolUse": [
      {
        "matcher": "fs_write",
        "command": "/home/nizar/.kiro/hooks/check-secrets.sh",
        "description": "Block writes containing secrets"
      },
      {
        "matcher": "execute_bash",
        "command": "/home/nizar/.kiro/hooks/guard-destructive-commands.sh",
        "description": "Block dangerous shell commands"
      }
    ],
    "stop": [
      {
        "command": "/home/nizar/.kiro/hooks/flywheel-log.sh",
        "description": "Log turn summary for flywheel analysis"
      }
    ]
  },
  "toolsSettings": {},
  "useLegacyMcpJson": false,
  "model": "claude-sonnet-4.6"
}
