{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "light",
  "description": "Fast agent with memory, docs, web search, and GitHub access",
  "mcpServers": {
    "agentcore-memory": {
      "command": "/home/nizar/HomeWspce/sample-amazon-bedrock-agentcore-memory-mcp-server/venv/bin/python3",
      "args": [
        "/home/nizar/HomeWspce/sample-amazon-bedrock-agentcore-memory-mcp-server/bedrock_agentcore_memory_mcp_server.py"
      ],
      "env": {
        "AGENTCORE_MEMORY_ID": "kiro_sessions_memory-gyjyxdCmPK",
        "AWS_REGION": "ca-central-1",
        "AWS_PROFILE": "csna-operations-sso-828",
        "ACTOR_ID_TYPE": "userid",
        "PROJECT_ID": "",
        "FASTMCP_LOG_LEVEL": "WARNING"
      },
      "disabled": false
    },
    "remote.aws-knowledge": {
      "description": "AWS official documentation, best practices, pricing, limits, and how-to guides.",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://knowledge-mcp.global.api.aws"
      ],
      "disabled": false
    },
    "firecrawl": {
      "description": "Web scraping, crawling, search, and autonomous web research.",
      "command": "python3",
      "args": [
        "/home/nizar/HomeWspce/kiro-configs/wrappers/firecrawl_wrapper.py"
      ],
      "disabled": false
    },
    "github": {
      "description": "GitHub operations: read repos, browse code, search files, manage issues and PRs.",
      "command": "python3",
      "args": [
        "/home/nizar/.kiro/wrappers/github_wrapper.py"
      ],
      "env": {
        "GITHUB_READ_ONLY": "0",
        "GITHUB_TOOLSETS": "all"
      },
      "disabled": false
    },
    "notion-workspace": {
      "description": "Notion workspace \u2014 create, read, update, search pages.",
      "command": "python3",
      "args": [
        "/home/nizar/.kiro/wrappers/notion_wrapper.py"
      ],
      "env": {
        "GITHUB_REPO": "nizarajroud/notion-images"
      },
      "disabled": false
    },
    "mcp-image-recognition": {
      "description": "Image analysis (READ-ONLY) via Bedrock vision models. Requires gateway on localhost:8766.",
      "command": "python3",
      "args": [
        "/home/nizar/HomeWspce/kiro-configs/wrappers/mcp_image_recognition_wrapper.py"
      ],
      "disabled": false
    },
    "bookmarks": {
      "description": "Search Chrome and Edge bookmarks (7260+ Chrome, 2454+ Edge).",
      "command": "python3",
      "args": [
        "/home/nizar/HomeWspce/kiro-configs/wrappers/bookmarks_wrapper.py"
      ],
      "disabled": false
    },
    "sequential-thinking": {
      "description": "Sequential thinking for complex planning, debugging, and architecture decisions.",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "disabled": false
    },
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time"
      ],
      "locked": false,
      "disabled": false,
      "description": "Current time and timezone conversions."
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "locked": false,
      "disabled": false,
      "description": "Fetch URL content as markdown."
    },
    "memory-light": {
      "description": "Persistent memory for Light agent \u2014 stores quick notes, preferences, and context across sessions.",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "/home/nizar/HomeWspce/kiro-configs/memories/memory-light.jsonl"
      },
      "disabled": false
    },
    "mcp-everything-search": {
      "description": "Fast file search across all disks (Windows via /mnt/c/ + Linux). Uses plocate. Query by filename, extension, pattern.",
      "command": "uvx",
      "args": [
        "mcp-server-everything-search"
      ],
      "disabled": false
    },
    "mcp-tts": {
      "description": "Text-to-Speech \u2014 reads text aloud via Google Gemini TTS. Use when user asks to read, speak, or listen to content.",
      "command": "/home/nizar/go/bin/mcp-tts",
      "args": [],
      "env": {
        "GOOGLE_AI_API_KEY": "${GOOGLE_AI_API_KEY}",
        "MCP_TTS_SUPPRESS_SPEAKING_OUTPUT": "true",
        "PIPER_MODEL": "/home/nizar/.local/share/piper-voices/en_US-lessac-medium.onnx"
      },
      "disabled": false
    }
  },
  "tools": [
    "*"
  ],
  "useLegacyMcpJson": false
}
