        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "/home/nizar/HomeWspce/kiro-configs/memories/memory-supervisor.jsonl"
      },
      "disabled": false,
      "priority": "critical"
    }
  },
  "tools": [
    "execute_bash",
