{
  "name": "compass",
  "description": "Personal life orchestrator — routes questions about personal affairs to the right data sources (NotebookLM, Notion, Gmail, TickTick, Excel, Telegram, Bookmarks) and synthesizes answers with citations.",
  "prompt": "file://../prompts/compass-prompt.md",
  "mcpServers": {
    "memory-compass": {
      "description": "Persistent memory — stores user preferences, routing corrections, and patterns across sessions.",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "/home/nizar/HomeWspce/kiro-configs/memories/memory-compass.jsonl"
      },
      "disabled": false,
      "locked": false,
      "priority": "critical"
    }
  },
  "tools": [
    "execute_bash",
    "code",
    "fs_read",
    "fs_write",
    "grep",
    "glob",
    "@notebooklm",
    "@notion-workspace",
    "@gmail",
    "@ticktick",
    "@excel",
    "@telegram",
    "@bookmarks",
    "@alithya-knowledge-rag",
    "@pdf-reader",
    "@markitdown",
    "@memory-compass",
    "@airtable",
