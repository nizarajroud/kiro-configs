{
  "name": "compass",
  "description": "Personal life orchestrator \u2014 routes questions about personal affairs to the right data sources (NotebookLM, Notion, Gmail, TickTick, Excel, Telegram, Bookmarks) and synthesizes answers with citations.",
  "prompt": "file://../prompts/compass-prompt.md",
  "mcpServers": {
    "memory-compass": {
      "description": "Persistent memory \u2014 stores user preferences, routing corrections, and patterns across sessions.",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "/home/nizar/HomeWspce/kiro-configs/memories/memory-compass.jsonl"
      },
      "disabled": false
    }
  },
  "tools": [
    "fs_read",
    "fs_write",
    "grep",
    "glob",
    "@notebooklm",
    "@notion-workspace",
    "@gmail",
    "@ticktick",
    "@excel",
    "@telegram",
    "@bookmarks",
    "@alithya-knowledge-rag",
    "@pdf-reader",
    "@memory-compass",
    "@airtable"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "@memory-compass",
    "@bookmarks"
  ],
  "resources": [
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/personal/steering/*.md",
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/personal/config/domains.yaml",
    "file:///home/nizar/HomeWspce/kiro-configs/knowledges/personal/domains/**/steering/*.md"
  ],
  "hooks": {},
  "toolAliases": {
    "@airtable/create_table": "airtable_create_table"
  },
  "toolsSettings": {},
  "welcomeMessage": "\ud83e\udded Compass ready. Ask me anything about your personal life \u2014 I'll find the answer.",
  "useLegacyMcpJson": true
}
