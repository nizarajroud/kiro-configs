{
  "mcpServers": {
    "time": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-time"
      ]
    },
    "notion-workspace": {
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "GITHUB_REPO": "nizarajroud/notion-images"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "bookmarks": {
      "command": "npx",
      "args": [
        "-y",
        "browser-bookmarks-mcp"
      ]
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-fetch"
      ],
      "env": {}
    }
  }
}