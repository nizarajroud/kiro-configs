{
  "mcpServers": {
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time"
      ]
    },
    "notion-workspace": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "http://192.168.2.56:3227/mcp",
        "--allow-http"
      ],
      "env": {
        "GITHUB_REPO": "nizarajroud/notion-images"
      },
      "_original": {
        "command": "npx",
        "args": [
          "-y",
          "@notionhq/notion-mcp-server"
        ]
      },
      "disabled": false
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "bookmarks": {
      "command": "python3",
      "args": [
        "/home/nizar/HomeWspce/kiro-configs/wrappers/bookmarks_wrapper.py"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    }
  }
}