# Machine configuration for local MCP servers via supergateway
# Servers run on this WSL but accessed via HTTP (shared across sessions)

# Machine identity
MACHINE_NAME=envywsl
MACHINE_HOST=localhost

# SSH access (local WSL)
SSH_PORT=22
SSH_USER=nizar
SSH_KEY=~/.ssh/id_rsa_wsl

# MCP server ports
BASE_PORT=3100
PORT_COUNT=200

# Supergateway config
SUPERGATEWAY_CMD="npx -y supergateway"
LOG_DIR=/tmp

# Remote paths
REMOTE_PROJECT_DIR=/home/nizar/HomeWspce/kiro-configs/scripts
REMOTE_KIRO_CONFIGS=/home/nizar/HomeWspce/kiro-configs
